{
  "key": "DeathGame",
  "name": "DeathGame",
  "type": "legacy-twig",
  "entry": "index.html",
  "description": "Legacy DeathGame site template adapted for SphereWeb3 runtime data, languages, news, servers, and ratings.",
  "preview": "images/logo.png",
  "tags": ["legacy", "twig", "site"],
  "routes": [
    {
      "pattern": "^/$",
      "template": "index.html"
    },
    {
      "pattern": "^/about/?$",
      "template": "about.html"
    },
    {
      "pattern": "^/page/(.+)$",
      "template": "static.html"
    },
    {
      "pattern": "^/read/(.+)$",
      "template": "static.html"
    }
  ]
}
