{
  "id": "exchange",
  "name": "Биржа игровых ценностей",
  "description": "Доверенная биржа предметов L2jLucera с заморозкой предмета, заказами, чатом и административным арбитражем.",
  "version": "1.3.0",
  "apiVersion": "1",
  "author": "SphereWeb3",
  "enabled": true,
  "backend": {
    "runtime": "lua",
    "entry": "backend/main.lua"
  },
  "frontend": {
    "userEntry": "frontend/index.js",
    "adminEntry": "frontend/admin.js",
    "styles": ["frontend/style.css"],
    "userPath": "/plugins/exchange",
    "adminPath": "/admin/plugins/exchange",
    "title": {"ru": "Биржа игровых ценностей", "en": "Game valuables exchange", "ua": "Біржа ігрових цінностей", "es": "Mercado de objetos", "pt": "Mercado de itens", "gr": "Αγορά αντικειμένων"},
    "adminTitle": {"ru": "Управление биржей", "en": "Exchange management"},
    "actions": [
      {
        "id": "exchange",
        "slot": "dashboard.balance.actions.after",
        "label": {"ru": "Биржа", "en": "Exchange", "ua": "Біржа", "es": "Mercado", "pt": "Mercado", "gr": "Αγορά"},
        "path": "/plugins/exchange",
        "variant": "primary",
        "summaryPath": "/summary",
        "summaryField": "openOrders",
        "requiresLogin": true
      }
    ],
    "menu": [
      {
        "id": "exchange-menu",
        "label": {"ru": "Биржа", "en": "Exchange", "ua": "Біржа", "es": "Mercado", "pt": "Mercado", "gr": "Αγορά"},
        "path": "/plugins/exchange",
        "icon": "ShoppingCart",
        "placement": "user",
        "sortOrder": 25,
        "requiresLogin": true,
        "summaryPath": "/summary",
        "summaryField": "openOrders"
      }
    ]
  },
  "routes": [
    {"method": "GET", "path": "/summary", "handler": "get_summary", "access": "user"},
    {"method": "GET", "path": "/state", "handler": "get_state", "access": "user"},
    {"method": "POST", "path": "/rules/accept", "handler": "accept_rules", "access": "user"},
    {"method": "GET", "path": "/lots", "handler": "list_lots", "access": "user"},
    {"method": "GET", "path": "/my-lots", "handler": "list_my_lots", "access": "user"},
    {"method": "GET", "path": "/characters", "handler": "list_characters", "access": "user"},
    {"method": "GET", "path": "/characters/:id/items", "handler": "list_character_items", "access": "user"},
    {"method": "GET", "path": "/payment-profile", "handler": "get_payment_profile", "access": "user"},
    {"method": "PUT", "path": "/payment-profile", "handler": "save_payment_profile", "access": "user"},
    {"method": "POST", "path": "/lots", "handler": "create_lot", "access": "user"},
    {"method": "POST", "path": "/lots/:id/cancel", "handler": "cancel_lot", "access": "user"},
    {"method": "POST", "path": "/lots/:id/order", "handler": "create_order", "access": "user"},
    {"method": "GET", "path": "/orders", "handler": "list_orders", "access": "user"},
    {"method": "GET", "path": "/orders/:id", "handler": "get_order", "access": "user"},
    {"method": "POST", "path": "/orders/:id/messages", "handler": "send_message", "access": "user"},
    {"method": "POST", "path": "/orders/:id/admin-request", "handler": "request_admin", "access": "user"},
    {"method": "POST", "path": "/orders/:id/confirm-payment", "handler": "confirm_payment", "access": "user"},
    {"method": "GET", "path": "/admin/dashboard", "handler": "admin_dashboard", "access": "admin"},
    {"method": "GET", "path": "/admin/orders", "handler": "admin_list_orders", "access": "admin"},
    {"method": "GET", "path": "/admin/orders/:id", "handler": "admin_get_order", "access": "admin"},
    {"method": "POST", "path": "/admin/orders/:id/messages", "handler": "admin_send_message", "access": "admin"},
    {"method": "POST", "path": "/admin/orders/:id/action", "handler": "admin_order_action", "access": "admin"},
    {"method": "GET", "path": "/admin/access", "handler": "admin_list_access", "access": "admin"},
    {"method": "PUT", "path": "/admin/access/:userId", "handler": "admin_save_access", "access": "admin"}
  ],
  "jobs": [
    {"name": "cleanup", "handler": "cleanup_job", "everySeconds": 3600, "runOnStart": false},
    {"name": "reconcile", "handler": "reconcile_job", "everySeconds": 300, "runOnStart": true}
  ],
  "settings": [
    {"key": "enabled", "type": "boolean", "label": {"ru": "Биржа включена", "en": "Exchange enabled"}, "default": true},
    {
      "key": "gameSql",
      "type": "json",
      "label": {"ru": "Специфичные SQL-запросы биржи", "en": "Exchange-specific SQL queries"},
      "description": {"ru": "Только escrow-операции, которых нет в JSON-каталоге сборки сервера.", "en": "Only escrow operations that are absent from the server build JSON query catalog."},
      "required": true,
      "default": {
        "characterById": "SELECT obj_Id AS id, char_name AS name, account_name, online FROM characters WHERE obj_Id = ?",
        "characterByIdForUpdate": "SELECT obj_Id AS id, account_name, online FROM characters WHERE obj_Id = ? FOR UPDATE",
        "itemWithVariationByOwner": "SELECT i.*, COALESCE(v.stat1, 0) AS augmentation_stat1, COALESCE(v.stat2, 0) AS augmentation_stat2 FROM items i LEFT JOIN items_variation v ON v.item_id = i.item_id WHERE i.item_id = ? AND i.owner_id = ?",
        "itemWithVariationByOwnerForUpdate": "SELECT i.*, COALESCE(v.stat1, 0) AS augmentation_stat1, COALESCE(v.stat2, 0) AS augmentation_stat2 FROM items i LEFT JOIN items_variation v ON v.item_id = i.item_id WHERE i.item_id = ? AND i.owner_id = ? FOR UPDATE",
        "freezeItem": "UPDATE items SET owner_id = ?, amount = ? WHERE item_id = ? AND owner_id = ?",
        "restoreItem": "UPDATE items SET owner_id = ? WHERE item_id = ? AND owner_id = ?",
        "itemOwnerForUpdate": "SELECT owner_id FROM items WHERE item_id = ? FOR UPDATE",
        "deliverItem": "UPDATE items SET owner_id = ?, location = 'INVENTORY' WHERE item_id = ? AND owner_id = ?",
        "itemOwner": "SELECT owner_id FROM items WHERE item_id = ?"
      }
    },
    {"key": "gameSqlByServer", "type": "json", "label": {"ru": "SQL-запросы по серверам", "en": "SQL queries by server"}, "description": {"ru": "Настройки SQL, сохранённые отдельно для каждого сервера L2jLucera.", "en": "SQL settings saved separately for each L2jLucera server."}, "default": {}},
    {"key": "activationAt", "type": "datetime", "label": {"ru": "Дата и время запуска", "en": "Activation date"}, "description": {"ru": "Оставьте пустым для немедленного запуска."}, "default": ""},
    {"key": "commissionMode", "type": "select", "label": {"ru": "Расчёт комиссии", "en": "Commission mode"}, "default": "fixed", "options": [{"value": "fixed", "label": {"ru": "Фиксированная", "en": "Fixed"}}, {"value": "percent", "label": {"ru": "Процент от цены в USD", "en": "Percent of USD price"}}]},
    {"key": "commissionFixed", "type": "number", "label": {"ru": "Фиксированная комиссия, Donate Coin", "en": "Fixed commission"}, "default": 10},
    {"key": "commissionPercent", "type": "number", "label": {"ru": "Комиссия, %", "en": "Commission, %"}, "default": 5},
    {"key": "commissionMinimum", "type": "number", "label": {"ru": "Минимальная комиссия", "en": "Minimum commission"}, "default": 1},
    {"key": "currencyRatesUSD", "type": "json", "label": {"ru": "Курсы к USD", "en": "Rates to USD"}, "description": {"ru": "Объект вида {\"USD\":1,\"UAH\":0.024,\"RUB\":0.011}."}, "default": {"USD": 1, "UAH": 0.024, "RUB": 0.011}},
    {"key": "orderTimeoutHours", "type": "number", "label": {"ru": "Таймаут заказа, часов", "en": "Order timeout, hours"}, "default": 72},
    {"key": "orderTimeoutAction", "type": "select", "label": {"ru": "Действие по таймауту", "en": "Timeout action"}, "default": "admin", "options": [{"value": "none", "label": {"ru": "Ничего не делать", "en": "Do nothing"}}, {"value": "admin", "label": {"ru": "Подключить администратора", "en": "Escalate to administrator"}}, {"value": "cancel_refund", "label": {"ru": "Отменить и вернуть комиссию", "en": "Cancel and refund"}}]},
    {"key": "closedRetentionDays", "type": "number", "label": {"ru": "Хранить закрытые заказы, дней", "en": "Closed order retention, days"}, "default": 31},
    {"key": "rulesVersion", "type": "text", "label": {"ru": "Версия правил", "en": "Rules version"}, "default": "1"},
    {"key": "rulesByLocale", "type": "localized_richtext", "label": {"ru": "Правила биржи", "en": "Exchange rules"}, "required": true, "default": {"ru": "<h2>Правила использования биржи</h2><p>Размещая лот или открывая заказ, вы подтверждаете достоверность предоставленной информации и соглашаетесь выполнять решения администрации при споре.</p>", "en": "<h2>Exchange rules</h2><p>By listing or ordering an item you accept these rules and administrative dispute decisions.</p>", "ua": "<h2>Правила використання біржі</h2>", "es": "<h2>Reglas del mercado</h2>", "pt": "<h2>Regras do mercado</h2>", "gr": "<h2>Κανόνες αγοράς</h2>"}}
  ],
  "locales": ["ru", "en", "ua", "es", "pt", "gr"]
}
