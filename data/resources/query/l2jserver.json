    "plugin_get_farm_top": {
      "targetDb": "game",
      "isPublic": false,
      "query": [
        "SELECT ",
        "    i.item_id AS item_id,",
        "    SUM(i.count) AS total_count,",
        "    (",
        "        SELECT sub.owner_id ",
        "        FROM items AS sub ",
        "        WHERE sub.item_id = i.item_id ",
        "        GROUP BY sub.owner_id ",
        "        ORDER BY SUM(sub.count) DESC ",
        "        LIMIT 1",
        "    ) AS top_owner_id,",
        "    (",
        "        SELECT ch.char_name ",
        "        FROM characters AS ch ",
        "        WHERE ch.charId = (",
        "            SELECT sub.owner_id ",
        "            FROM items AS sub ",
        "            WHERE sub.item_id = i.item_id ",
        "            GROUP BY sub.owner_id ",
        "            ORDER BY SUM(sub.count) DESC ",
        "            LIMIT 1",
        "        )",
        "    ) AS top_owner_name,",
        "    (",
        "        SELECT SUM(owner_items.count) ",
        "        FROM items AS owner_items ",
        "        WHERE owner_items.item_id = i.item_id ",
        "          AND owner_items.owner_id = (",
        "            SELECT sub.owner_id ",
        "            FROM items AS sub ",
        "            WHERE sub.item_id = i.item_id ",
        "            GROUP BY sub.owner_id ",
        "            ORDER BY SUM(sub.count) DESC ",
        "            LIMIT 1",
        "        )",
        "    ) AS top_owner_item_count",
        "FROM items i",
        "WHERE i.item_id IN (%s)  ",
        "GROUP BY i.item_id;"
      ]
    }
