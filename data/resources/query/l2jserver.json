{
  "build": "l2jServer",
  "block": true,
  "passwordHashAlgorithm": "sha1",
  "queries": {
    "pvp": {
      "targetDb": "game",
      "isPublic": true,
      "query": [
        "SELECT ",
        "    ch.charId AS player_id,",
        "    ch.char_name AS player_name,",
        "    ch.pvpkills AS pvp,",
        "    ch.pkkills AS pk,",
        "    ch.sex,",
        "    ch.online,",
        "    ch.onlinetime AS time_in_game,",
        "    cd.clan_name AS clan_name,",
        "    cd.clan_level AS clan_level,",
        "    ch.classid AS class_id,",
        "    ch.level AS LEVEL,",
        "    cr1.data AS clan_crest,",
        "    cr2.data AS alliance_crest",
        "FROM characters ch",
        "LEFT JOIN clan_data cd ON ch.clanid = cd.clan_id",
        "LEFT JOIN crests cr1 ON cd.crest_id = cr1.crest_id",
        "LEFT JOIN crests cr2 ON cd.ally_crest_id = cr2.crest_id",
        "ORDER BY ch.pvpkills DESC, time_in_game DESC",
        "LIMIT 10;"
      ]
    },
