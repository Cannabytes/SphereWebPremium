    "clan": {
      "targetDb": "game",
      "isPublic": true,
      "query": [
        "SELECT ",
        "    cd.hasCastle AS castle_id,",
        "    cd.reputation_score AS reputation_score,",
        "    cd.leader_id,",
        "    ch.char_name AS player_name,",
        "    ch.pvpkills AS pvp,",
        "    ch.pkkills AS pk,",
        "    ch.online,",
        "    ch.onlinetime AS time_in_game,",
        "    ch.sex,",
        "    cd.clan_name,",
        "    cd.clan_level,",
        "    cr1.data AS clan_crest,",
        "    cr2.data AS alliance_crest,",
        "    (SELECT COUNT(*) FROM characters WHERE clanid = cd.clan_id) AS clan_count_members",
        "FROM clan_data cd",
        "LEFT JOIN characters ch ON cd.leader_id = ch.charId",
        "LEFT JOIN crests cr1 ON cd.crest_id = cr1.crest_id",
        "LEFT JOIN crests cr2 ON cd.ally_crest_id = cr2.crest_id",
        "ORDER BY cd.reputation_score DESC, clan_count_members DESC",
        "LIMIT 10;"
      ]
    },
    "castle": {
      "targetDb": "game",
      "isPublic": true,
      "query": [
        "SELECT ",
        "    c.id AS castle_id,",
        "    c.taxPercent AS tax,",
        "    c.treasury,",
        "    c.siegeDate AS dataSiege,",
        "    cd.clan_name,",
        "    cd.clan_level,",
        "    ch.char_name AS player_name,",
        "    cr1.data AS clan_crest,",
        "    cr2.data AS alliance_crest",
        "FROM castle c",
        "LEFT JOIN clan_data cd ON c.id = cd.hasCastle",
        "LEFT JOIN characters ch ON cd.leader_id = ch.charId",
        "LEFT JOIN crests cr1 ON cd.crest_id = cr1.crest_id",
        "LEFT JOIN crests cr2 ON cd.ally_crest_id = cr2.crest_id",
        "WHERE cd.leader_id IS NOT NULL;"
      ]
    },
